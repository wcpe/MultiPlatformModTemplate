<?xml version="1.0" encoding="UTF-8"?>
<!--
  MPMT SpotBugs 排除过滤器（严格门禁）。
  仅登记确认为框架契约 / 生成代码 / 按设计行为的误报；每条注明原因（static-analysis §3：集中声明）。
-->
<FindBugsFilter>
    <!-- Lombok @Value/@EqualsAndHashCode 生成的 equals/hashCode 含冗余空检查（RCN）。@lombok.Generated
         已写入字节码（lombok.config），但 SpotBugs 4.8.6 默认未据此跳过——故按方法精确排除；
         业务方法里的 RCN 仍照常检出。 -->
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
        <Or>
            <Method name="equals"/>
            <Method name="hashCode"/>
        </Or>
    </Match>

    <!-- v2 报告校验入口仅由本地严格门调用。workspaceFile 已对输入执行 canonical 解析、当前工作区
         startsWith 边界校验及普通文件校验；FindSecBugs 无法推断该组合校验，仍把 File(String) 标为
         SECPTI。仅精确放行该方法，其他外部路径读取继续严格检出。 -->
    <Match>
        <Class name="top.wcpe.mc.mpmt.acceptance.report.AcceptanceReportV2ValidationMain"/>
        <Method name="workspaceFile"/>
        <Bug pattern="PATH_TRAVERSAL_IN"/>
    </Match>

    <!-- 连接句柄按设计在 L3 内部暴露平台原生对象（Bukkit Player / ServerPlayer 等），供 L3 传输解封后
         发送；平台对象不泄漏进 L0/L1（ADR-0001）。此处 EI 为预期行为。 -->
    <Match>
        <Class name="~.*ConnectionHandle"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- 协议包为短生命周期传输 DTO（@Value），byte[] 载荷仅在可靠性层内部流转；对其 getter/构造做
         防御性拷贝在分片热路径上不划算。protocol.packet 包内 EI/EI2 豁免。 -->
    <Match>
        <Package name="~top\.wcpe\.mc\.mpmt\.protocol\.packet"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- 误报：SpotBugs 误判 Netty FriendlyByteBuf/ByteBuf 的 readBytes(byte[])/writeBytes(byte[]) 为
         "无副作用"，实则二者会读写缓冲并推进读/写指针（返回 this 仅供链式调用，本不需要）。Forge 裸字节
         收发（ADR-0018）正是依赖其副作用填充/写入缓冲。仅放行该两类 RV，业务侧真实 RV 仍照常检出。 -->
    <Match>
        <Class name="top.wcpe.mc.mpmt.platform.forge.net.ForgeRawPayloadRouter"/>
        <Bug pattern="RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT"/>
    </Match>
    <Match>
        <Class name="top.wcpe.mc.mpmt.platform.forge.net.ForgeServerTransport"/>
        <Bug pattern="RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT"/>
    </Match>
    <!-- 同上误报：Fabric L4 版本绑定经 FriendlyByteBuf.writeBytes/readBytes 收发裸字节，依赖其填充/
         写入缓冲的副作用（返回 this 仅供链式调用，本不需要）。仅放行该两类 RV，业务侧真实 RV 仍照常检出。 -->
    <Match>
        <Class name="top.wcpe.mc.mpmt.platform.fabric.version.v1_20.V1_20ServerNetwork"/>
        <Bug pattern="RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT"/>
    </Match>
    <Match>
        <Class name="top.wcpe.mc.mpmt.platform.fabric.version.v1_20.V1_20ClientNetwork"/>
        <Bug pattern="RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT"/>
    </Match>

    <!-- 按设计：@Mod 入口由 Forge 启动期一次性实例化，其构造函数即平台装配点，把活跃传输发布到
         volatile static Holder 供同进程验收驱动 mod 读取（ADR-0002 Holder 形态、启动期一次写入后只读）。
         此 ST 为 Holder 模式的预期一次性写入，非可变全局状态滥用。仅放行该入口类。 -->
    <Match>
        <Class name="top.wcpe.mc.mpmt.platform.forge.MpmtForgeMod"/>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
    </Match>

    <!-- 同上按设计：NeoForge @Mod 入口与 Forge 镜像同一 Holder 形态（ADR-0002，启动期一次写入后只读）：
         构造期把活跃传输写入 volatile static Holder（ST），静态 getter 返回该传输供同进程验收驱动 mod 读取
         （MS，传输对象本就需被同进程共享、非可变数组/集合的内部表示泄漏）。仅放行该入口类。 -->
    <Match>
        <Class name="top.wcpe.mc.mpmt.platform.neoforge.MpmtNeoForgeMod"/>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD,MS_EXPOSE_REP"/>
    </Match>
</FindBugsFilter>
